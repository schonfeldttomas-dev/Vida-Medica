            <div class="category-card" onclick="filterProducts('test')">
                <div class="category-icon">🦠</div>
                <h4>Test Antígeno</h4>
                <p>Tests rápidos COVID, influenza</p>
            </div>
        </div>
    </section>

    <!-- Products -->
    <section class="products" id="productos">
        <div class="section-title">
            <h3>Productos Destacados</h3>
            <p>Los productos que más eligen nuestros clientes</p>
        </div>
        <div class="products-grid" id="productsGrid">
            <!-- Products will be loaded here -->
        </div>
